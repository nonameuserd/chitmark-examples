/**
 * Shared API types for Chitmark by Open Agent Ledger.
 * Aligns with openapi/openapi.yaml and SDK.md.
 */
/** Routing decision from verify. When degraded, this is always "challenge". */
type Decision = "allow" | "challenge" | "deny";
/** Classified actor behind the inbound action. */
type ActorType = "human" | "agent_principal" | "agent_abusive" | "unknown";
/** Whether a returned verdict is meant to gate traffic or only be observed. */
type EnforcementMode = "enforce" | "log_only";
/** Known action surfaces; custom strings are also accepted. */
type Action = "signup" | "trial_activation" | "api_key" | "demo_request" | "quote" | "ticket" | "custom" | (string & {});
/** Outcomes reported via feedback: the data moat. Prefer fast labels first. */
type Outcome = "credit_burn" | "multi_account_cluster" | "abuse_confirmed" | "converted" | "chargeback" | "churned" | "false_positive";
/** Asymmetric-cost challenge methods (best → worst for anti-abuse). */
type ChallengeMethod = "payment_preauth" | "proof_of_work" | "device_attestation" | "web_bot_auth_stepup" | "email_otp";
/** Client-side PII minimization mode. Default is hashed. Raw is opt-in only. */
type PiiMode = "raw" | "hashed" | "none";
/** Environment target; selects default base URL. */
type ChitmarkEnv = "production" | "staging" | "development";
/** On timeout/error, client decision fallback. NEVER "allow". */
type OnDegraded = "challenge";
/**
 * Principal resolution: mostly populated for good signed agents;
 * sparse for farmers.
 */
interface Principal {
    resolved: boolean;
    /** Bot maker from Web Bot Auth Signature-Agent (e.g. "openai"). */
    operator?: string;
    /** End-user principal ("on whose behalf"); often null at the wedge. */
    onBehalfOf?: string;
    identityBasis: string[];
}
/** Verdict object: single source of truth for a verify call. */
interface Verdict {
    /** When degraded === true, this is ALWAYS "challenge", never "allow". */
    decision: Decision;
    actorType: ActorType;
    /** 0..1 */
    confidence: number;
    /** Human-readable; always populated for ops teams. */
    reasons: string[];
    principal: Principal;
    /** ES256 JWT decision receipt, bound to session. */
    verdictToken: string;
    /** Store on the account row: feedback join key. */
    eventId: string;
    /** true → served under timeout/error → decision forced to challenge. */
    degraded: boolean;
    /** log_only verdicts are for dashboards/observation, not partner-side blocking. */
    enforcementMode: EnforcementMode;
    /** true → this allow honors a challenge completed for the session (context.challengeId). */
    challengeCleared?: boolean;
}
/** Subject signals for verify. Prefer hashed fields over raw PII. */
interface Subject {
    email?: string;
    emailSha256?: string;
    ip?: string;
    ipTrunc?: string;
    userAgent?: string;
    /** Includes Web Bot Auth headers when present. */
    headers?: Record<string, string | string[] | undefined>;
    formData?: Record<string, unknown>;
    formDataHashed?: Record<string, unknown>;
}
/**
 * Cost ratio that repositions the allow/challenge/deny boundaries for a
 * single verify. Higher `falseAllow` challenges earlier (abuse-averse);
 * higher `falseChallenge` lets more of the gray zone through; higher
 * `falseDeny` reserves deny for confirmed abuse. Defaults 1:1:3 keep the
 * fail-to-challenge semantics. Missing/non-positive fields fall back to
 * their default.
 */
interface DecisionCosts {
    falseAllow?: number;
    falseChallenge?: number;
    falseDeny?: number;
}
/** Per-request policy flags for POST /v1/verify. */
interface VerifyContext {
    /** Reference a challenge completed for this session; honored once. */
    challengeId?: string;
    /** "default" challenges the gray zone; "confirmed_tail_only" allows it in enforce mode. */
    challengePolicy?: "default" | "confirmed_tail_only";
    /** True → observation-only `log_only` verdict: nothing is blocked or challenged. */
    logOnly?: boolean;
    /** Reposition the allow/challenge/deny boundaries (defaults 1:1:3). */
    decisionCosts?: DecisionCosts;
    /** Partner-specific flags (e.g. plan, referrer), carried, not scored. */
    [key: string]: unknown;
}
/** Request body for POST /v1/verify. */
interface VerifyRequest {
    idempotencyKey?: string;
    action: Action;
    /** Binds any resulting challenge + verdictToken to THIS session. */
    session?: string;
    surface?: string;
    subject: Subject;
    context?: VerifyContext;
}
/** Request body for POST /v1/feedback. */
interface FeedbackRequest {
    eventId: string;
    outcome: Outcome;
    /** $ of infra/credit burned, or ARR: units in `unit`. */
    value?: number;
    unit?: string;
    observedAt?: string;
}
/** Response from POST /v1/feedback. */
interface FeedbackResponse {
    ok: true;
    eventId: string;
}
/**
 * Scales the proof-of-work difficulty issued with a challenge so the
 * challenge's economic tax rises with risk. Absent → "default".
 */
type ChallengeRiskTier = "default" | "elevated" | "severe";
/** Request body for POST /v1/challenge: issue or complete. */
interface ChallengeRequest {
    /** eventId from the verify verdict that routed to challenge. */
    eventId: string;
    /** Binds the challenge to this session; completion and re-verify must match. */
    session?: string;
    /** Ranked method preference, best → worst. Never defaults to email_otp. */
    prefer?: ChallengeMethod[];
    /** Completion mode: the challenge being solved. */
    challengeId?: string;
    /** Completion mode: server-verified proof bound to challengeId + session. */
    proof?: ChallengeProof;
    /**
     * Issue-mode context. `riskTier` scales the issued proof-of-work difficulty
     * so the challenge's economic tax rises with risk; completion is always
     * validated against the difficulty that was issued.
     */
    context?: {
        riskTier?: ChallengeRiskTier;
    };
}
/** Server-verified completion proof. */
type ChallengeProof = {
    type: "proof_of_work";
    /** First nonce where sha256(`${challengeId}:${seed}:${nonce}`) hex starts with `difficulty` zero nibbles. */
    nonce: string;
} | {
    type: "stripe_setup_intent";
    /** SetupIntent id from the issued instructions; status must be succeeded. */
    setupIntentId: string;
};
/** Response from POST /v1/challenge (issue mode). */
interface ChallengeResponse {
    challengeId: string;
    method: ChallengeMethod;
    instructions: {
        type: "pow";
        /** Leading zero nibbles required in the sha256 hex digest. */
        difficulty: number;
        /** Combine as `${challengeId}:${seed}:${nonce}`. */
        seed: string;
        algorithm: "sha256-prefix";
    } | {
        type: "stripe_setup_intent";
        /** test = real Stripe test-mode; stub = deterministic local/CI id. */
        mode: "test" | "stub";
        clientSecret: string;
        publishableKey?: string;
    };
    /** Solving only clears THIS session (anti-replay). */
    boundTo: string;
    expiresAt: string;
}
/** Response from POST /v1/challenge (completion mode). */
interface ChallengeCompletionResponse {
    ok: true;
    challengeId: string;
    /** Session that was cleared (single use, anti-replay). */
    boundTo: string;
    clearedAt: string;
}
/** Client constructor options. */
interface ChitmarkOptions {
    /** API key (Bearer). Use process.env.CHITMARK_API_KEY. */
    apiKey: string;
    /**
     * Timeout/error behavior. Fixed to "challenge": never allow silent bypass.
     * @default "challenge"
     */
    onDegraded?: OnDegraded;
    /**
     * Client-side request budget in ms. Edge path is far faster.
     * @default 800
     */
    timeoutMs?: number;
    /**
     * Client-side PII minimization before send.
     * @default "hashed"
     */
    piiMode?: PiiMode;
    /**
     * Selects default base URL unless baseUrl or CHITMARK_BASE_URL is set.
     * @default "production"
     */
    env?: ChitmarkEnv;
    /**
     * Override API host (e.g. local edge). Precedence:
     * baseUrl > CHITMARK_BASE_URL env > env default.
     */
    baseUrl?: string;
    /** Custom fetch implementation (Workers, tests). */
    fetch?: typeof fetch;
    /** User-Agent / client identification sent as X-Chitmark-Client. */
    clientName?: string;
}
interface ChitmarkErrorBody {
    error: string;
    message?: string;
    code?: string;
}

/**
 * Base error for all Chitmark client failures.
 */
declare class ChitmarkError extends Error {
    name: string;
    readonly status?: number;
    readonly code?: string;
    readonly body?: ChitmarkErrorBody | string;
    constructor(message: string, options?: {
        status?: number;
        code?: string;
        body?: ChitmarkErrorBody | string;
