/**
 * Official Chitmark client (Open Agent Ledger): three verbs:
 * verify, feedback, challenge. Trust decisions on agent-mediated actions,
 * tuned by business outcomes.
 *
 * @example
 * ```ts
 * const chitmark = new Chitmark({ apiKey: process.env.CHITMARK_API_KEY! });
 * const verdict = await chitmark.verify({
 *   action: "signup",
 *   subject: { email, ip, userAgent },
 * });
 * ```
 */
declare class Chitmark {
    private readonly apiKey;
    private readonly baseUrl;
    private readonly timeoutMs;
    private readonly piiMode;
    private readonly onDegraded;
    private readonly fetchImpl;
    private readonly clientName;
    constructor(options: ChitmarkOptions);
    /**
     * Score + route an inbound action (signup / trial / …).
     * Hot path at the edge; client budget defaults to 800ms.
     * On timeout/transport error, or a malformed verdict shape from the API,
     * returns a degraded challenge verdict (never allow, never crashes).
     *
     * Persist `v.eventId` on the account row: feedback joins only on that id.
     */
    verify(request: VerifyRequest): Promise<Verdict>;
    /**
     * Report a downstream outcome joined on the stored eventId from verify.
     * This is the data moat: attribution is a schema contract, not a fuzzy match.
     */
    feedback(request: FeedbackRequest): Promise<FeedbackResponse>;
    /**
     * Issue an asymmetric-cost challenge after decision === challenge | degraded.
     */
    challenge(request: ChallengeRequest): Promise<ChallengeResponse>;
