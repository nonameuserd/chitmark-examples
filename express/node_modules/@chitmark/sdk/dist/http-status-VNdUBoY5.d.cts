 */
declare function hashEmailSha256(email: string): Promise<string>;
/**
 * Truncate IPv4 to /24 or IPv6 to /48 for coarse geo without host identity.
 */
declare function truncateIp(ip: string): string;
/**
 * Reduce form payload to non-PII keys (domain-style fields only for hashed mode).
 * Free-text is dropped; companyDomain-style keys are kept as-is when domain-like.
 */
declare function minimizeFormData(formData: Record<string, unknown> | undefined): Record<string, unknown> | undefined;

