     * Complete a challenge by submitting its solved proof. Clears only the bound
     * session, once. Re-verify with `context.challengeId` to have the next
     * verify honor the cleared session.
     */
    completeChallenge(request: {
        eventId: string;
        challengeId: string;
        session?: string;
        proof: ChallengeProof;
    }): Promise<ChallengeCompletionResponse>;
    /**
     * Verify a verdictToken's signature against the API's JWKS and its session /
     * origin binding. Rejects expired tokens, unknown kids, and
     * invalid signatures with `VerdictTokenError`. Pass `session` to enforce
     * session binding (recommended) and `aud` to enforce origin binding.
     */
    verifyVerdictToken(token: string, options?: Omit<VerifyVerdictTokenOptions, "jwksUrl" | "fetch">): Promise<VerdictTokenClaims>;
    /**
     * Low-level HTTP helper. Prefer verify / feedback / challenge.
     */
    request<T>(path: string, init: {
        method: string;
        body?: unknown;
        idempotencyKey?: string;
    }): Promise<T>;
    /** Public accessors for inspection / tests. */
    get config(): {
        baseUrl: string;
        timeoutMs: number;
        piiMode: PiiMode;
        onDegraded: OnDegraded;
    };
}

/**
 * Client-side PII minimization helpers.
 * Default SDK mode hashes email and truncates IP before leaving the customer process.
 */
